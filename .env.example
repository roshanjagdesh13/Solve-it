# ─────────────────────────────────────────────────────────────────────────────
# File Solver — Environment Configuration Example
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Your OpenAI API key.  Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────

# The model to use for solving.  Default: gpt-4o
# Other options: gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# SOLVER_MODEL=gpt-4o

# Maximum input file size in megabytes.  Default: 50
# MAX_FILE_SIZE=50

# Default output directory (leave empty to write next to the input file)
# OUTPUT_DIRECTORY=
